rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1) TROQUE pelos e-mails do RH que podem ver as respostas (entre aspas, separados por vírgula)
    function ehRH() {
      return request.auth != null
        && request.auth.token.email in ['rhmdf01@sudati.com.br', 'mayara@sudati.com.br'];
    }

    match /respostas/{id} {
      // 2) TROQUE pelo código de acesso do convite (em MAIÚSCULAS)
      allow create: if request.resource.data.codigo == 'QUALI2026'
                    && request.resource.data.grupo is string
                    && request.resource.data.criadoEm == request.time
                    && request.resource.data.size() <= 80;
      allow read, delete: if ehRH();
      allow update: if false;
    }

    // DISC, hipóteses e roteiro: só o RH
    match /rh/{doc} {
      allow read, write: if ehRH();
    }

    // Todo o resto fica bloqueado
    match /{caminho=**} {
      allow read, write: if false;
    }
  }
}
